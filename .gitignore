# These patterns apply to every project, including deeply nested folders.

# Dependencies (keep package.json and lockfiles in Git)
node_modules/

# Generated builds and test coverage
dist/
build/
coverage/
.nyc_output/

# Tool caches
.vite/
.cache/
.parcel-cache/
.npm/
.pnpm-store/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Logs
*.log

# Local environment files (keep safe templates in Git)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini
